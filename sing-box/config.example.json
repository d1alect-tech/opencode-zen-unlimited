      },
      {
        "inbound": [
          "socks-1087"
        ],
        "action": "route",
        "outbound": "nl-hy2"
      },
      {
        "inbound": [
          "socks-1088"
        ],
        "action": "route",
        "outbound": "de-hy2"
      },
      {
        "inbound": [
          "socks-1091"
        ],
        "action": "route",
        "outbound": "pl-hy2"
      },
      {
        "inbound": [
          "socks-1093"
        ],
        "action": "route",
        "outbound": "cz-hy2"
      },
      {
        "inbound": [
          "socks-1097"
        ],
        "action": "route",
        "outbound": "nl-hy2"
      },
      {
        "inbound": [
          "socks-1099"
        ],
        "action": "route",
        "outbound": "fi-hy2"
      },
      {
        "inbound": [
          "socks-1100"
        ],
        "action": "route",
        "outbound": "pl-hy2"
      }
    ],
    "final": "direct",
    "default_domain_resolver": "doh-11"
  }
}

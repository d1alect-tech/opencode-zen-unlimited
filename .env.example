# opencode-zen-unlimited — env-only secrets. Copy to .env (gitignored), never commit real values.
# Generate strong random keys with: openssl rand -hex 32
#   Use the output for JWT/API_KEY/STORAGE-style secrets (RR_WATCH_TOKEN below).
# Placeholders in docs/configs use YOUR_* — replace with env values at runtime.

# --- Gateway :20128 ---
# PORT defaults to 20128 when unset (loopback bind only).
PORT=20128
# Comma-separated egress proxy URLs. Accepted schemes: SOCKS pool
# (socks5/socks5h/socks/socks4/socks4a) plus purchased HTTP(S) proxies
# (http/https, `user:pass@` auth optional, e.g. managed with
# `zen add-proxy <url>` which appends with dedup + .bak backup).
# e.g. socks5h://127.0.0.1:1081,socks5h://127.0.0.1:1082
# e.g. http://user:pass@proxy.example.com:8080,https://user:pass@proxy.example.com:8443
# Empty = direct connection (tests/dev default).
EGRESS_UPSTREAMS=
# Upstream body inactivity budget, ms. The stream is cut when no bytes flow
# for this long (rotation benches the egress and fails over). Default 120000
# fits long generations with reasoning pauses (big-file edits); lower it
# (e.g. 30000) for faster dead-egress failover, raise for slower upstreams.
# Empty/non-integer/non-positive = default.
STALL_TIMEOUT_MS=
# Upstream headers wait budget, ms. Must stay under the client's own headers
# timeout (OpenCode gives up at 30s) so rotation fails over in time.
# Empty/non-integer/non-positive = default 15000.
HEADERS_TIMEOUT_MS=

# --- Relay :1090 (src/relay/rr-socks.mjs) ---
# Bearer token the 429-watcher sends to GET /api/usage/proxy-logs.
# Generate: openssl rand -hex 32
RR_WATCH_TOKEN=YOUR_RR_WATCH_TOKEN
# Watcher polling (defaults match rr-socks.mjs when unset).
RR_WATCH_URL=http://localhost:20128/api/usage/proxy-logs?limit=20
RR_WATCH_INTERVAL_MS=15000
RR_COOLDOWN_MS=900000

# --- Egress (Hysteria2, via sub-converter -> sing-box) ---
# Subscription URL is secret, env-only. Never paste into docs/.scratch (use YOUR_SUB_URL).
# Example: EGRESS_SUB_URL=https://example.com/sub
EGRESS_SUB_URL=YOUR_SUB_URL
# Shared Hy2 auth password placeholder. Nothing injects this into generated
# sing-box outbounds — the template keeps YOUR_HY2_PASSWORD literally and
# node passwords come from the subscription link itself. Keep the placeholder
# unless your setup explicitly wires this key at runtime.
HY2_PASSWORD=YOUR_HY2_PASSWORD
